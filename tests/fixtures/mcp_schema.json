{
  "bus_get_tour_detail": {
    "description": "Fetch detailed information, schedule, pricing, and bus stops for a specific Maitabi mountain bus tour by course_no.\n\nReturns a JSON string containing complete tour itinerary, bus departure points, seat options, pricing, and lodging info.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "course_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            }
          ],
          "description": "Internal course number(s) on bus.maitabi.jp (e.g., 14241, 8518). Can be a single int or list of ints for batch fetching."
        }
      },
      "required": [
        "course_no"
      ],
      "type": "object"
    }
  },
  "bus_list_district_groups": {
    "description": "Fetch mountain area/district groups and tour counts for Maitabi mountain bus tours.\n\nSupports cascading filtering—district groups and counts update dynamically based on other selected filters.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Area/direction ID (e.g., 18=Tateyama Murodo, 10=Kamikochi, 0=All)"
        },
        "bus_sheet": {
          "anyOf": [
            {
              "description": "Bus seat configuration ID for mountain bus tours.",
              "enum": [
                1,
                2,
                3,
                4,
                5,
                6
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bus seat type: 1=Standard, 2=Premium, 3=Outbound Premium / Inbound Standard, 4=Outbound Standard / Inbound Premium, 5=Double seat, 6=Taxi"
        },
        "course_cd": {
          "anyOf": [
            {
              "maxLength": 50,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maitabi course code (e.g., 'S104C21')"
        },
        "day": {
          "anyOf": [
            {
              "maximum": 31,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Departure day (1-31)"
        },
        "departure": {
          "default": 1,
          "description": "Departure point: 1=Tokyo (Takebashi/Shinjuku), 2=Osaka/Kyoto, 3=Nagoya",
          "enum": [
            1,
            2,
            3
          ],
          "type": "integer"
        },
        "keyword": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Search keyword in Japanese (e.g., '立山', '上高地')"
        },
        "month": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Departure month (1-12). Defaults to current month if omitted."
        },
        "return_day": {
          "anyOf": [
            {
              "description": "Return date option ID for mountain bus tours relative to departure.",
              "enum": [
                1,
                2,
                3,
                4,
                5
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Return date option: 1=1 day after departure, 2=2 days after, 3=3 days after, 4=4 days after, 5=5 days after"
        },
        "stay1": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mountain lodge ID for night 1 (e.g., 5=Enzanso, 2=Nishiho Sanso)"
        },
        "stay2": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mountain lodge ID for night 2"
        },
        "stay3": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mountain lodge ID for night 3"
        },
        "style": {
          "anyOf": [
            {
              "description": "Tour style ID for mountain bus tours.",
              "enum": [
                1,
                2,
                3,
                4,
                5,
                6,
                7
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tour style: 1=Round-trip bus, 2=Outbound bus, 3=Inbound bus, 4=Round-trip lodge, 5=Outbound lodge, 6=Overnight day-trip, 7=Taxi plan"
        }
      },
      "type": "object"
    }
  },
